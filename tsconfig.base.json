{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@agw/types": ["./packages/types/src"],
      "@agw/core": ["./packages/core/src"],
      "@agw/security": ["./packages/security/src"],
      "@agw/mcp-client": ["./packages/mcp-client/src"],
      "@agw/tool-platform": ["./packages/tool-platform/src"],
      "@agw/provider-bridge": ["./packages/provider-bridge/src"],
      "@agw/cron": ["./packages/cron/src"],
      "@agw/memory-engine": ["./packages/memory-engine/src"],
      "@agw/agent-core": ["./packages/agent-core/src"],
      "@agw/logger": ["./packages/logger/src"]
      "@agw/database": ["./packages/database/src"]
    }
  }
}
