# ══════════════════════════════════════════════
# Kairo — .gitignore
# ══════════════════════════════════════════════

# ── Kairo Premium binary (proprietary, never commit) ──
kairo-auth
*.license

# ── Secrets (never commit) ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
secrets.enc
master.key
.gh-token

# ── Bare metal launcher (generated by setup-local.sh) ──
kairo

# ── Local reference (untracked, kept on disk) ──
_local/
docs/_local_reference/

# ── Runtime data (app-managed) ──
agw-data/
kairoclaw-data/
local_data/
docker-compose.dev.yml
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.log

agw-data-new/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.log

# ── Dependencies ──
node_modules/
bun.lock
bun.lockb

# ── Build artifacts ──
dist/
build/
coverage/
*.tsbuildinfo

# ── OS files ──
.DS_Store
Thumbs.db

# ── Claude Code ──
.claude/
CLAUDE.md

# ── Editor / IDE ──
.vscode/
.idea/
*.swp
*~

# ── Docker ──
docker-compose.override.yml

# ── Ad-hoc scratch scripts (never commit) ──
# Throwaway repro/fuzz scripts dropped in package roots. Real tests live under
# each package's src/__tests__/.
packages/*/test_*.mjs
packages/*/fuzz_*.mjs
scratch_*.mjs
*.scratch.mjs
