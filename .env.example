# ══════════════════════════════════════════════════════════
# Kairo — Environment Variables
# ══════════════════════════════════════════════════════════
#
# Quick start:
#   cp .env.example .env
#   Fill in at least one LLM provider key below
#   docker compose up -d
#
# This file is gitignored — your secrets stay local.
# config.json references these as ${VAR} and is safe to commit.
#
# ══════════════════════════════════════════════════════════

# ── LLM Providers (set at least one) ──

# Anthropic — standard API key (usage-based billing)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Anthropic — OAuth token (uses Claude Pro/Max subscription)
# Get it with: claude setup-token
# ANTHROPIC_AUTH_TOKEN=sk-ant-oat-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Ollama — local models, no API key needed
# Default: http://localhost:11434 (or http://host.docker.internal:11434 in Docker)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.3

# ── Channels ──

# Telegram bot token (from @BotFather)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ── Tools ──

# Brave Search API key (enables web_search tool)
# Get one at: https://brave.com/search/api/
# BRAVE_API_KEY=BSA...

# ── Gateway ──

# Authentication token for Web UI + API access
# If empty, the gateway is open (not recommended for public networks)
# AGW_TOKEN=choose-a-strong-token-here

# Port override (default: 18181)
# AGW_PORT=18181

# Log level (debug, info, warn, error)
# LOG_LEVEL=info

# ── Advanced ──

# Data directory (default: ~/.agw for bare metal, /data for Docker)
# AGW_STATE_DIR=/data

# Admin API key — set on first run to choose your own key
# If not set, a random key is generated and printed to console
# AGW_ADMIN_KEY=agw_sk_your-chosen-key

# Encryption master key — required for cloud/ephemeral deploys
# If not set, auto-generated as a file (persists on disk)
# WARNING: losing this key means all encrypted secrets are unrecoverable
# AGW_MASTER_KEY=your-64-char-hex-key

# PostgreSQL connection (default: SQLite)
# AGW_DATABASE_URL=postgres://user:pass@host:5432/kairoclaw

# CORS allowed origins (comma-separated)
# Required when accessing from non-localhost (e.g. http://your-server:18181)
# If not set and host is 0.0.0.0, all origins are allowed
# ALLOWED_ORIGINS=http://your-server:18181

# Deferred tool loading — only load core tools initially, discover rest via tool_search
# AGW_DEFER_TOOLS=true
