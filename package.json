{
  "name": "kairoclaw",
  "version": "0.3.0",
  "type": "module",
  "description": "Self-hosted multi-user AI operations platform — one agent, every channel, full control",
  "repository": "https://github.com/DhilipBinny/KairoClaw",
  "homepage": "https://github.com/DhilipBinny/KairoClaw",
  "license": "MIT",
  "author": "BSigma AI",
  "keywords": [
    "ai",
    "llm",
    "agent",
    "telegram",
    "whatsapp",
    "self-hosted",
    "multi-user",
    "mcp",
    "anthropic",
    "openai",
    "ollama"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build": "pnpm -r build",
    "dev:v2": "pnpm --filter @agw/core dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages/core/src/ packages/types/src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sandbox:build": "docker build -t kairoclaw-sandbox:full -f packages/sandbox/docker/Dockerfile.full ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "protobufjs",
      "sharp"
    ],
    "overrides": {
      "protobufjs": ">=7.5.5"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^17.3.1",
    "grammy": "^1.35.0",
    "json5": "^2.2.3",
    "openai": "^4.80.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@bsigma-ai/kairo-enterprise": "^0.2.3"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": ">=2.0.8",
      "tinypool": ">=1.1.1",
      "fast-uri": ">=3.1.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.2.4"
  }
}
